{
  "info": {
    "name": "ЛР 15 — Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "moderatorEmail",
      "value": "moderator@example.com"
    },
    {
      "key": "moderatorPassword",
      "value": "Moderator123!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "readerToken",
      "value": ""
    },
    {
      "key": "articleId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01. Список статей",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);",
              "pm.test(\"Pagination\", () => pm.expect(pm.response.json().articles).to.have.property(\"total\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Гость не может создать статью",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Forbidden\",\n  \"description\": \"Text\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Регистрация читателя",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Reader\",\n  \"email\": \"reader-{{$guid}}@example.test\",\n  \"password\": \"Reader123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);",
              "pm.collectionVariables.set(\"readerToken\", pm.response.json().token);",
              "pm.test(\"Reader role\", () => pm.expect(pm.response.json().user.role.name).to.eql(\"reader\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Читатель не может создать статью",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{readerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/articles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Forbidden\",\n  \"description\": \"Text\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "05. Вход модератора",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{moderatorEmail}}\",\n  \"password\": \"{{moderatorPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);",
              "pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "06. Текущий пользователь",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/user"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);",
              "pm.test(\"Moderator role\", () => pm.expect(pm.response.json().user.role.name).to.eql(\"moderator\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07. Проверка валидации",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/articles",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "08. Создание статьи",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/articles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Статья из Postman\",\n  \"description\": \"Проверка REST API\",\n  \"preview_image\": \"images/cats/cat1.jpg\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);",
              "pm.collectionVariables.set(\"articleId\", pm.response.json().article.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "09. Просмотр статьи",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles/{{articleId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Изменение статьи PATCH",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/articles/{{articleId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Обновлено из Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);",
              "pm.test(\"Changed title\", () => pm.expect(pm.response.json().article.title).to.eql(\"Обновлено из Postman\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Комментарий читателя",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{readerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/articles/{{articleId}}/comments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"Комментарий из Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);",
              "pm.collectionVariables.set(\"commentId\", pm.response.json().comment.id);",
              "pm.test(\"Pending moderation\", () => pm.expect(pm.response.json().comment.moderation_status).to.eql(\"pending\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Ожидающий комментарий скрыт",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles/{{articleId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);",
              "pm.test(\"Pending comment is hidden\", () => pm.expect(pm.response.json().comments.total).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Автор редактирует комментарий",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{readerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/articles/{{articleId}}/comments/{{commentId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"Изменённый комментарий\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Автор удаляет комментарий",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{readerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/articles/{{articleId}}/comments/{{commentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Удаление статьи",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/articles/{{articleId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "16. Удалённая статья недоступна",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/articles/{{articleId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "17. Выход модератора",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "18. Отозванный токен недействителен",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/user"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "19. Выход читателя",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{readerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    }
  ]
}
